{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "asiyst-plans",
	"main": "custom-worker.mjs",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"build": {
		"command": "node scripts/ensure-open-next-build.mjs"
	},
	"workers_dev": true,
	"preview_urls": true,
	"routes": [
		{
			"pattern": "plan.asiyst.com",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		}
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "asiyst-plans"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	},
	"vars": {
		"ASIYST_ENVIRONMENT": "production",
		"NEXT_PUBLIC_ASIYST_ENVIRONMENT": "production",
		"SUPABASE_URL": "https://nqhxpgsjofzqudyqkqib.supabase.co",
		"NEXT_PUBLIC_SUPABASE_URL": "https://nqhxpgsjofzqudyqkqib.supabase.co",
		"SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5xaHhwZ3Nqb2Z6cXVkeXFrcWliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc2Nzc4NjcsImV4cCI6MjEwMzI1Mzg2N30.KGlcT_Kciufel7FLFJxKdD4bHsymNUojsbZTworllgY",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5xaHhwZ3Nqb2Z6cXVkeXFrcWliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc2Nzc4NjcsImV4cCI6MjEwMzI1Mzg2N30.KGlcT_Kciufel7FLFJxKdD4bHsymNUojsbZTworllgY",
		"NEXT_PUBLIC_APP_URL": "https://plan.asiyst.com",
		"NEXT_PUBLIC_MAIN_APP_URL": "https://asiyst.com",
		"ASIIYST_API_BASE_URL": "https://asiyst.com",
		"DODO_PAYMENTS_ENVIRONMENT": "live_mode",
		"EMAIL_PROVIDER": "resend",
		"RESEND_FROM_EMAIL": "ASIYST <noreply@asiyst.com>",
		"RESEND_REPLY_TO": "support@asiyst.com"
	},
	"env": {
		"staging": {
			"name": "asiyst-plans-staging",
			"workers_dev": true,
			"preview_urls": true,
			"routes": [],
			"assets": {
				"directory": ".open-next/assets",
				"binding": "ASSETS"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "asiyst-plans-staging"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"triggers": {
				"crons": [
					"*/5 * * * *"
				]
			},
			"vars": {
				"ASIYST_ENVIRONMENT": "staging",
				"NEXT_PUBLIC_ASIYST_ENVIRONMENT": "staging",
				"SUPABASE_URL": "https://nqhxpgsjofzqudyqkqib.supabase.co",
				"NEXT_PUBLIC_SUPABASE_URL": "https://nqhxpgsjofzqudyqkqib.supabase.co",
				"SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5xaHhwZ3Nqb2Z6cXVkeXFrcWliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc2Nzc4NjcsImV4cCI6MjEwMzI1Mzg2N30.KGlcT_Kciufel7FLFJxKdD4bHsymNUojsbZTworllgY",
				"NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5xaHhwZ3Nqb2Z6cXVkeXFrcWliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc2Nzc4NjcsImV4cCI6MjEwMzI1Mzg2N30.KGlcT_Kciufel7FLFJxKdD4bHsymNUojsbZTworllgY",
				"NEXT_PUBLIC_APP_URL": "https://asiyst-plans-staging.workers.dev",
				"NEXT_PUBLIC_MAIN_APP_URL": "https://asiyst.com",
				"ASIIYST_API_BASE_URL": "https://asiyst.com",
				"DODO_PAYMENTS_ENVIRONMENT": "test_mode",
				"EMAIL_PROVIDER": "resend",
				"RESEND_FROM_EMAIL": "ASIYST <noreply@asiyst.com>",
				"RESEND_REPLY_TO": "support@asiyst.com"
			}
		}
	}
}
