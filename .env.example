# ================================================================
# Asiyst Plan (plan.asiyst.com) — Environment Variables
# ================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# NEVER expose secret keys with the NEXT_PUBLIC_ prefix.

# ================================================================
# 1. SUPABASE (Shared with Asiyst-WEB)
# ================================================================
ASIYST_ENVIRONMENT=production
NEXT_PUBLIC_ASIYST_ENVIRONMENT=production

# Public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local / Development Supabase overrides (optional)
NEXT_PUBLIC_DEVELOPMENT_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_DEVELOPMENT_SUPABASE_ANON_KEY=
DEVELOPMENT_SUPABASE_URL=http://127.0.0.1:54321
DEVELOPMENT_SUPABASE_ANON_KEY=
DEVELOPMENT_SUPABASE_SERVICE_ROLE_KEY=

# ================================================================
# 2. APPLICATION URLS & CROSS-APP INTEGRATION
# ================================================================
NEXT_PUBLIC_APP_URL=https://plan.asiyst.com
NEXT_PUBLIC_MAIN_APP_URL=https://asiyst.com
ASIIYST_API_BASE_URL=https://asiyst.com

# Shared internal secret for server-to-server calls & cron jobs
ASIYST_INTERNAL_SECRET=
CRON_SECRET=
ADMIN_SECRET_KEY=

# ================================================================
# 3. DODO PAYMENTS (Subscription Billing — Configure When Ready)
# ================================================================
# Set to 'test_mode' (Sandbox) or 'live_mode' (Production)
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=

# Official Asiyst Plan -> Dodo Product & Price Mappings
# Asiyst Zero ($0) requires NO Dodo product ID.
# Asiyst Pulse ($24/month = 2400 minor units USD)
DODO_PRODUCT_ID_PULSE=
DODO_PRICE_ID_PULSE=

# Asiyst Vector ($54/month = 5400 minor units USD)
DODO_PRODUCT_ID_VECTOR=
DODO_PRICE_ID_VECTOR=

# Asiyst Quantum ($154/month = 15400 minor units USD)
DODO_PRODUCT_ID_QUANTUM=
DODO_PRICE_ID_QUANTUM=

# ================================================================
# 4. TRANSACTIONAL EMAIL (Resend & Outbox Worker)
# ================================================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="ASIYST <noreply@asiyst.com>"
RESEND_REPLY_TO="support@asiyst.com"
EMAIL_WEBHOOK_SECRET=
ASIYST_EMAIL_INTERNAL_SECRET=
